# FFN Crucible publication policy -- what may never be committed or shipped.
#
# One file, two consumers: tools/publish-check.py reads it to gate the repo in CI,
# and it documents what a node operator must never let into a commit.
#
# tools/publish-check.py is a VERBATIM copy of FFN-NGFW's image/ffn-publish-check.py.
# It is not edited here on purpose: the leak that gate exists to prevent got through
# because two gates disagreed about what counted, and a forked checker is how they
# come to disagree. Only this policy file differs between the two repositories, and
# only where the paths and the risks genuinely differ.
#
# THE RULE, as set by the project owner:
#   No auth keys, master keys, or passwords are shipped.
#
# This repository has no equivalent of the appliance's default setup credential, so
# unlike FFN-NGFW's policy there is no exception to that rule here. There is instead
# a risk FFN-NGFW does not have: this repository's code SPOOLS MALWARE SAMPLES to
# disk while it runs, so a node operator working in a checkout can commit live
# malware by accident. That is what [deny-path] guards below.
#
# Syntax: [section] headers, one entry per line, "#" comments, blank lines ignored.
# Globs are fnmatch against the repo-relative path. Patterns are Python regexes.

# --------------------------------------------------------------------------------
# Paths that must never be tracked in git. Matched against every tracked file.
# --------------------------------------------------------------------------------
[deny-path]
# --- private key material -------------------------------------------------------
# The verdict-signing seed above all: its entire security property is that it
# never leaves the node that generated it. See VerdictSigner in ffn_crucible.py.
*/crucible-verdict.key
crucible-verdict.key
*/ssh_host_*_key
ssh_host_*_key
*/authorized_keys
authorized_keys
*.pem
*.p12
*.pfx
*/id_rsa
*/id_ed25519
*/id_ecdsa
*.key
# --- submitter credentials ------------------------------------------------------
*/crucible-node.token
crucible-node.token
*.token
*/jwt.secret
*/identity.secret

# --- SPOOLED MALWARE ------------------------------------------------------------
# ffn_crucible_node.py writes every submitted object under its spool directory,
# two levels of hash fan-out deep. Those files are live malware. This is the rule
# that stops `git add -A` in a node's working directory from publishing them.
samples/*
*/samples/*
spool/*
*/spool/*
*.sample
*.malware

# --- analysis state and output ---------------------------------------------------
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
# A capture holds whatever the sample sent, which can include exfiltrated data.
*.pcap
*.pcapng
trace.log
*.dmp

# --- guest images ----------------------------------------------------------------
# Gigabytes, built rather than authored, and a prepared guest contains a licensed
# OS that must not be redistributed.
*.qcow2
*.img
*.img.gz
*.vmdk
*.iso

# --------------------------------------------------------------------------------
# Exceptions to deny-path. Each needs a stated reason.
# --------------------------------------------------------------------------------
[allow-path]
# Public keys are not secret, and a client needs one to verify a verdict at all.
*.pub
*/crucible-verdict.pub

# --------------------------------------------------------------------------------
# Content patterns that must never appear in a tracked file. This is the section
# that catches what the filename gates cannot.
# --------------------------------------------------------------------------------
[deny-content]
# PEM-armoured private keys, whatever the file is called. Anchored to its own
# line: real PEM armour starts at column 0.
^\s*-----BEGIN [A-Z ]*PRIVATE KEY-----\s*$
^\s*-----BEGIN OPENSSH PRIVATE KEY-----\s*$
# A 64-hex-character ed25519 seed assigned to a variable. The signing seed is
# stored as bare hex (see VerdictSigner._load_hex), so it has no PEM armour to
# catch and this is the only shape that would find it pasted into source.
(?:SEED|seed|PRIVKEY|privkey|SIGNING_KEY|signing_key)\s*=\s*["'][0-9a-fA-F]{64}["']
# A literal assigned to a password variable. The permitted form is an expansion
# with an empty default, so the value comes from the environment.
(?:FFN_ROOT_PW|ROOT_PW|ADMIN_PW|FFN_ADMIN_PASSWORD)\s*=\s*["'][^"'$][^"']{5,}["']
# A literal secret fallback: SECRET = os.getenv(<env name>, <quoted literal>).
# Written descriptively rather than verbatim -- a worked example here would match
# this very rule, and the policy file must satisfy its own policy.
(?:JWT_SECRET|SESSION_SECRET|SECRET_KEY|API_KEY|API_TOKEN|BEARER_TOKEN)\s*=\s*["'][^"'$][^"']{7,}["']
# A literal secret default. Excludes path-shaped defaults: os.getenv(
# "FFN_CRUCIBLE_SEED", "/etc/ffn-ngfw/crucible-verdict.key") names a FILE.
os\.getenv\(\s*["'][A-Z_]*(?:SECRET|TOKEN|SEED)[A-Z_]*["']\s*,\s*["'](?![./~])[^"'/]{7,}["']\s*\)
# A yescrypt/sha-crypt hash pasted into a tracked file.
\$(?:y|6|5)\$[./A-Za-z0-9]{8,}

# --------------------------------------------------------------------------------
# Build-host and lab identity. A published repository must not carry the
# developer's hostname, addresses or NIC names.
#
# Unlike FFN-NGFW's policy this section has NO baseline: the repository was
# extracted clean and CI must keep it that way, so any hit is a new leak.
# --------------------------------------------------------------------------------
[deny-identity]
# Development and lab management subnets.
\b10\.1\.0\.(?:9[0-9]|1[0-9][0-9])\b
\b172\.19\.0\.[0-9]{1,3}\b
# Lab NIC names and the ZeroTier interface.
\beno1np0\b
\beno2np1\b
\benp179s0f0np0\b
\bztbtov4b2k\b
# The development host's name used as a value.
FFN_HOSTNAME\s*=\s*["']?ffn-ngfw["']?
<hostname>ffn-ngfw</hostname>

# --------------------------------------------------------------------------------
# Baselined pre-existing identity, as "path :: regex".
#
# Only the policy and its checker, which necessarily contain the patterns they
# match. Nothing else is baselined, and nothing else should be added: an entry
# here is a to-do, not an excuse.
# --------------------------------------------------------------------------------
[allow-identity]
tools/PUBLISH-POLICY :: .*
tools/publish-check.py :: .*
.github/workflows/*.yml :: .*
